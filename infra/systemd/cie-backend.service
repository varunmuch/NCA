[Unit]
Description=CareerIntel backend (FastAPI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=exouser
WorkingDirectory=/home/exouser/cie/backend
ExecStart=/home/exouser/cie/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
