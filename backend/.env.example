CIE_AUTH_BRIDGE_SECRET=change-me
CIE_ALLOWED_ORIGINS=http://localhost:3001
CIE_DATABASE_URL=postgresql+asyncpg://cie:CHANGE_ME@127.0.0.1:5432/cie

# Career data refresh (scripts/refresh_career_data.py)
# BLS Public Data API v2 key: https://data.bls.gov/registrationEngine/
CIE_BLS_API_KEY=
# Contact address sent in the User-Agent; bls.gov requires one for file downloads
CIE_DATA_CONTACT_EMAIL=
# Optional, for scholarships: https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CIE_CAREERONESTOP_USER_ID=
CIE_CAREERONESTOP_TOKEN=
